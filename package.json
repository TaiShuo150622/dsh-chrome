{
  "name": "dsh-desktop-chrome",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "DSH Desktop provider that drives the user's real Chrome through a Chrome MV3 extension and native messaging.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./browser-use": "./vendor/browser-use/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/**/*.js",
    "host/**/*",
    "extension/**/*",
    "vendor/**/*",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test:p0": "node test/p0-bridge.mjs && node test/p0-tools.mjs"
  }
}
